{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "lock-local",
  "description": "Narrow local IPC for the app-lock screen. Per-command authorization is also enforced in Rust (is_lock_window).",
  "windows": ["lock"],
  "permissions": [
    "core:default",
    "allow-get-lock-status",
    "allow-get-theme",
    "allow-reset-app-lock",
    "allow-unlock-biometric",
    "allow-unlock-password"
  ]
}
